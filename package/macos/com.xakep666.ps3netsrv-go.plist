<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xakep666.ps3netsrv-go</string>
    <key>Program</key>
    <string>/usr/local/bin/ps3netsrv-go</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ps3netsrv-go</string>
        <string>server</string>
        <string>--listen-addr=activated:NetISO</string>
        <string>--system-log</string>
    </array>
    <key>Sockets</key>
    <dict>
        <key>NetISO</key>
        <dict>
            <key>SockServiceName</key>
            <string>38008</string>
            <key>SockType</key>
            <string>stream</string>
            <key>SockFamily</key>
            <!-- using IPv4 address family because PS3 does not support IPv6 -->
            <string>IPv4</string>
        </dict>
    </dict>
</dict>
</plist>
